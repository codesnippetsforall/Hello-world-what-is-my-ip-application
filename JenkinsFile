pipeline {
    agent any

    environment {
        IMAGE_NAME = 'whatismyip:v1'
        CONTAINER_NAME = 'whatismyip-app'
        HOST_PORT = '888'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/codesnippetsforall/Hello-world-what-is-my-ip-application.git'
            }
        }

        stage('Code-Check') {
            steps {
                echo 'Checking required files...'
                sh '''
                    test -f Dockerfile
                    test -f index.html
                    echo "Dockerfile and index.html are present "
                '''
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                sh '''
                    ls -la
                    docker build -t ${IMAGE_NAME} .
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Validating image exists...'
                sh 'docker image inspect ${IMAGE_NAME}'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying container on port ${HOST_PORT}..."
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d --name ${CONTAINER_NAME} -p ${HOST_PORT}:80 --restart unless-stopped ${IMAGE_NAME}
                    docker ps | grep ${CONTAINER_NAME}
                '''
            }
        }
    }

    post {
        success {
            sh '''
                HOST_IP=$(curl -s --max-time 2 http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)
                if [ -z "$HOST_IP" ]; then
                  HOST_IP=$(curl -s --max-time 3 https://checkip.amazonaws.com 2>/dev/null || true)
                fi
                if [ -z "$HOST_IP" ]; then
                  HOST_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
                fi
                echo "App is live at http://${HOST_IP}:${HOST_PORT}/"
            '''
        }
        failure {
            echo 'Pipeline failed. Check Docker is installed and Jenkins can run docker commands.'
        }
    }
}
